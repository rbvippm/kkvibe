    <style>
        body {
            background-color: #F8FAFC;
            font-family: "Inter", sans-serif;
            height: 100vh;
            margin: 0;
            padding: 0;
            font-size: 14px;
        }

        .page {
            display: flex;
            justify-content: center;
            width: 100%;
            height: 100%;
            margin: 0;
        }

        .centered {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .content {
            flex: 1;
            width: 384px;
        }

        .primary-content {
            background-color: #FFFFFF;
            border-radius: 4px;
            box-shadow: 0px 1px 3px 0px #0000001A;
            padding: 20px;
            text-align: center;
            margin-top: 45%;
        }

        .primary-content-title {
            margin-top: 10px;
            font-weight: 600;
            font-size: 14px;
            color: #1e293b;
        }

        .primary-content-body {
            margin-top: 10px;
            color: #64748B;
        }

        .secondary-content {
            margin-top: 30px;
            color: #64748B;
            text-align: center;
        }

        .footer {
            display: flex;
            color: #64748B;
            margin-bottom: 10px;
        }

        .link-secondary,
        .link-secondary:link,
        .link-secondary:visited,
        .link-secondary:hover,
        .link-secondary:active {
            margin-left: 2px;
            color: #64748B;
            text-decoration: none;
        }

        .support-link {
            color: #64748B;
        }

        .link-secondary:focus-visible {
            outline: 1px solid #64748B;
        }

        .logo-container {
            margin-bottom: 14px;
        }

        .logo-image {
            width: 82px;
        }

        .button-primary {
            background-color: #2563eb;
            height: 30px;
            line-height: 14px;
            font-weight: 500;
            display: inline-block;
            color: #FFFFFF;
            border-radius: 4px;
            border: none;
            padding: 8px;
            font-family: "Inter", sans-serif;
        }

        .link-button-primary,
        .link-button-primary:visited,
        .link-button-primary:link,
        .link-button-primary:active {
            background-color: #2563eb;
            height: 14px;
            line-height: 14px;
            font-weight: 500;
            display: inline-block;
            color: #FFFFFF;
            border-radius: 4px;
            padding: 8px;
            text-decoration: none;
        }

        .button-primary:hover,
        .button-primary:focus,
        .link-button-primary:hover,
        .link-button-primary:focus {
            background-color: #1e40af;
            text-decoration: none;
        }

        .button-primary:focus-visible,
        .link-button-primary:focus-visible,
        .link-logo:focus-visible {
            outline: 1px solid #4f46e5;
        }

        .license-info {
            background-color: #450a0a;
            color: #FEE2E2;
            padding: 5px;
            margin-bottom: 20px;
            border: 1px solid #7F1D1D;
            border-radius: 4px;
        }

        .input-primary {
            color: #1e293b;
            border: 1px solid #e2e8f0;
            height: 30px;
            border-radius: 4px;
            font-size: 14px;
            line-height: 20px;
            outline: none;
            padding-left: 8px;
            padding-right: 8px;
        }

        .input-primary:hover {
            border: 1px solid #94a3b8;
        }

        .input-primary:focus,
        .input-primary:focus-visible {
            border: 1px solid #4f46e5;
        }
    </style>

    

